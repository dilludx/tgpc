name: 📄 Dispatch PDF Sync

on:
  schedule:
    - cron: '0 9 * * *'  # Daily at 9:00 AM IST
  workflow_dispatch:  # Allow manual triggering

jobs:
  dispatch-sync:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    
    steps:
    - name: Checkout repository
      uses: actions/checkout@v6
      env:
        FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: true
      with:
        token: ${{ secrets.GITHUB_TOKEN }}
        fetch-depth: 2
    
    - name: Set up Python
      uses: actions/setup-python@v6
      env:
        FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: true
      with:
        python-version: '3.11'
    
    - name: Install dependencies
      run: |
        python -m pip install --upgrade pip
        pip install -e .
    
    - name: Run dispatch sync
      id: sync
      run: |
        python -m tgpc dispatch
    
    - name: Commit and push changes
      if: ${{ steps.sync.outcome == 'success' }}
      run: |
        git config --local user.email "action@github.com"
        git config --local user.name "GitHub Action"
        
        # Add PDF files and HTML
        git add docs/dispatchpdf/
        git add docs/dispatch.html
        
        # Check if there are changes
        if git diff --cached --quiet; then
          echo "No changes to commit."
          exit 0
        fi
        
        # Get IST time for commit message
        IST_TIME=$(TZ='Asia/Kolkata' date '+%a %d %b %Y • %H:%M IST')
        
        # Count new PDFs
        NEW_PDFS=$(git diff --cached --name-only | grep -c 'docs/dispatchpdf/' || true)
        
        # Commit message
        COMMIT_MSG="📄 Dispatch Sync • ${IST_TIME}"
        if [ "$NEW_PDFS" -gt 0 ]; then
          COMMIT_MSG="${COMMIT_MSG} • +${NEW_PDFS} PDFs"
        fi
        
        git commit -m "$COMMIT_MSG"
        
        # Pull latest changes and merge safely
        git pull origin "${{ github.ref_name }}" --no-rebase
        
        git push origin HEAD:"${{ github.ref_name }}"
    
    - name: Create summary
      if: always()
      run: |
        {
          echo "### 📄 Dispatch PDF Sync • $(TZ='Asia/Kolkata' date '+%a %d %b %Y' | tr '[:lower:]' '[:upper:]') • $(TZ='Asia/Kolkata' date '+%H:%M IST')"
          echo ""
        } >> "$GITHUB_STEP_SUMMARY"
        
        # Count PDFs
        PDF_COUNT=$(find docs/dispatchpdf -name '*.pdf' 2>/dev/null | wc -l)
        echo "Total PDF files: ${PDF_COUNT}" >> "$GITHUB_STEP_SUMMARY"
