# Security headers for static assets served directly by Cloudflare Pages.
# HTML pages and /api/* also get these via src/hooks.server.ts (the hook
# cannot set headers on static-asset responses, and _headers cannot see
# function responses, so both are needed). Keep these in sync.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://pub-4591c8c5282040459ade2ed1e5e3d5be.r2.dev; connect-src 'self' https://vhgpyvzgmvhijqgsapnk.supabase.co; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

/favicon.*
  Cache-Control: no-cache

/manifest.json
  Cache-Control: no-cache
